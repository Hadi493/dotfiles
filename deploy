#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Set to 1 to auto-accept replacement of existing files/dirs without prompting.
force_yes=0

link_one() {
    local src="$1"
    local dst="$2"

    if [ ! -e "$src" ]; then
        echo "Skipping (missing): $src"
        return 0
    fi

    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
        echo "Destination exists and is not a symlink: $dst"
        if [ "$force_yes" -eq 1 ]; then
            echo "  (--yes) replacing it"
        else
            read -r -p "Replace it with a symlink to the dotfile? [y/N] " ans
            case "$ans" in
                y|Y|yes|YES)
                    ;;
                *)
                    echo "  Skipping (not replaced): $dst"
                    return 0
                    ;;
            esac
        fi
        local backup_dir="${DEPLOY_BACKUP_DIR:-$HOME/.deploy-backup}"
        local name backup_target i
        name="$(basename "$dst")"
        backup_target="$backup_dir/$name"
        i=1
        while [ -e "$backup_target" ]; do
            backup_target="$backup_dir/${name}.$i"
            i=$((i + 1))
        done
        mkdir -p "$backup_dir"
        if mv "$dst" "$backup_target" 2>/dev/null; then
            echo "  Backed up to $backup_target"
        else
            echo "  Move failed, removing $dst"
            rm -rf "$dst"
        fi
    fi

    mkdir -p "$(dirname "$dst")"
    ln -snfv "$src" "$dst"
}

link_emacs() {
    echo "Linking Emacs configuration..."
    local items=(
        ".emacs"
        ".emacs.custom.el"
        ".emacs.local"
        ".emacs.rc"
        ".emacs.snippets"
    )

    for item in "${items[@]}"; do
        link_one "$DOTFILES_DIR/emacs.conf/$item" "$HOME/$item"
    done
}

link_dunst() {
    echo     "Linking Dunst configuration..."
    link_one "$DOTFILES_DIR/.config/dunst" "$HOME/.config/dunst"
}

link_bash() {
    echo     "Linking Bash configuration..."
    link_one "$DOTFILES_DIR/.bashrc" "$HOME/.bashrc"
}

link_fastfetch() {
    echo     "Linking fastfetch configuration..."
    link_one "$DOTFILES_DIR/.config/fastfetch" "$HOME/.config/fastfetch"
}

link_cava() {
    echo     "Linking Cava configuration..."
    link_one "$DOTFILES_DIR/.config/cava" "$HOME/.config/cava"
}

link_mpv() {
    echo     "Linking MPV configuration..."
    link_one "$DOTFILES_DIR/.config/mpv" "$HOME/.config/mpv"
}

link_fish() {
    echo     "Linking Fish configuration..."
    link_one "$DOTFILES_DIR/.config/fish" "$HOME/.config/fish"
}

link_nushell() {
    echo     "Linking Nushell configuration..."
    link_one "$DOTFILES_DIR/.config/nushell" "$HOME/.config/nushell"
}

link_helix() {
    echo     "Linking Helix configuration..."
    link_one "$DOTFILES_DIR/.config/helix" "$HOME/.config/helix"
}

link_hypr() {
    echo     "Linking Hyprland configuration..."
    link_one "$DOTFILES_DIR/.config/hypr" "$HOME/.config/hypr"
}

link_kitty() {
    echo     "Linking Kitty configuration..."
    link_one "$DOTFILES_DIR/.config/kitty" "$HOME/.config/kitty"
}

link_nvim() {
    echo     "Linking Neovim configuration..."
    link_one "$DOTFILES_DIR/.config/nvim" "$HOME/.config/nvim"
}

link_vim() {
    echo     "Linking Vim configuration..."
    link_one "$DOTFILES_DIR/.vimrc" "$HOME/.vimrc"
}

link_rofi() {
    echo     "Linking Rofi configuration..."
    link_one "$DOTFILES_DIR/.config/rofi" "$HOME/.config/rofi"
}

link_noctalia() {
    echo     "Linking Noctalia configuration..."
    link_one "$DOTFILES_DIR/.config/noctalia" "$HOME/.config/noctalia"
}

link_tofi() {
    echo     "Linking Tofi configuration..."
    link_one "$DOTFILES_DIR/.config/tofi" "$HOME/.config/tofi"
}

link_tmux() {
    echo     "Linking Tmux configuration..."
    link_one "$DOTFILES_DIR/.config/tmux" "$HOME/.config/tmux"
}

link_flameshot() {
    echo     "Linking Flameshot configuration..."
    link_one "$DOTFILES_DIR/.config/flameshot" "$HOME/.config/flameshot"
}

link_st() {
    echo "Building suckless st (alpha patch, kitty/hypr theme)..."
    bash "$DOTFILES_DIR/st/build.sh"
}

link_fonts() {
    echo "Linking fonts..."
    local font_dir="$HOME/.local/share/fonts"
    mkdir -p "$font_dir"
    if [ -d "$DOTFILES_DIR/fonts" ]; then
        for font in "$DOTFILES_DIR/fonts"/*; do
            if [ -f "$font" ]; then
                link_one "$font" "$font_dir/$(basename "$font")"
            fi
        done
    else
        echo "Skipping (missing): $DOTFILES_DIR/fonts"
    fi
}

link_nob() {
    echo "Linking C Lib nob..."
    link_one "$DOTFILES_DIR/include" "/usr/include/nob.h"
}

link_config() {
    link_dunst
    link_bash
    link_fastfetch
    link_cava
    link_mpv
    link_fish
    link_nushell
    link_helix
    link_hypr
    link_kitty
    link_nvim
    link_vim
    link_rofi
    link_noctalia
    link_tmux
    link_tofi
    link_flameshot
    link_st
    link_fonts
    link_nob
}



link_bin() {
    echo "Linking binaries..."
    local files=(
        "wayland-boomer"
        "cg-timer"
        "paru"
        "toofan"
        "wal"
        "wlogout"
        "yay"
    )

    for file in "${files[@]}"; do
        link_one "$DOTFILES_DIR/bin/$file" "/usr/bin/$file"
    done
}

link_all() {
    link_emacs
    link_config
    link_bin
}

usage() {
    cat <<EOF
Usage: $0 [command]

Options:
  -y, --yes   Auto-accept replacing existing files/dirs (no prompt)

Commands:
  all        Link all configurations (default)
  emacs      Link Emacs configuration
  config     Link all .config directories
  bin        Link all binaries to /usr/bin/
  fonts      Link all fonts to ~/.local/share/fonts
  dunst      Link Dunst configuration
  bash       Link Bash configuration
  fastfetch  Link fastfetch configuration
  cava       Link cava configuration
  mpv        Link mpv configuration
  fish       Link Fish configuration
  nushell    Link Nushell Configuration
  helix      Link Helix configuration
  hypr       Link Hyprland configuration
  kitty      Link Kitty configuration
  nvim       Link Neovim configuration
  vim        Link Vim configuration
  rofi       Link Rofi configuration
  noctalia   Link Noctalia configuration
  tofi       Link Tofi configuration
  flameshot  Link Flameshot configuration
  st         Build suckless st terminal (kitty/hypr theme)
  tmux       Link Tmux configuration
  nob        Link Nob library

EOF
}

cmd="${1:-all}"
case "$cmd" in
    -y|--yes )
        force_yes=1
        cmd="${2:-all}"
        ;;
esac
case "$cmd" in
    all            ) link_all       ;;
    emacs          ) link_emacs     ;;
    config         ) link_config    ;;
    bin            ) link_bin       ;;
    fonts          ) link_fonts     ;;
    dunst          ) link_dunst     ;;
    bash           ) link_bash      ;;
    fastfetch      ) link_fastfetch ;;
    cava           ) link_cava      ;;
    mpv            ) link_mpv       ;;
    fish           ) link_fish      ;;
    nushell        ) link_nushell   ;;
    helix          ) link_helix     ;;
    hypr           ) link_hypr      ;;
    kitty          ) link_kitty     ;;
    nvim           ) link_nvim      ;;
    vim            ) link_vim       ;;
    rofi           ) link_rofi      ;;
    noctalia       ) link_noctalia  ;;
    tofi           ) link_tofi      ;;
    flameshot      ) link_flameshot ;;
    st             ) link_st        ;;
  tmux          ) link_tmux     ;;
    nob            ) link_nob       ;;
    -h|--help|help ) usage          ;;
    *              )
        usage
        exit 1
        ;;
esac
