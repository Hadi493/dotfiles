    echo     "Linking Waybar configuration..."
    link_one "$DOTFILES_DIR/.config/waybar" "$HOME/.config/waybar"
}

link_swaync() {
    echo     "Linking swaync configuration..."
    link_one "$DOTFILES_DIR/.config/swaync" "$HOME/.config/swaync"
}

link_kitty() {
    echo     "Linking Kitty configuration..."
    link_one "$DOTFILES_DIR/.config/kitty" "$HOME/.config/kitty"
}

link_nvim() {
    echo "Linking Neovim configuration..."
    link_one "$DOTFILES_DIR/.config/nvim" "$HOME/.config/nvim"
}

link_vis() {
    echo "Linking vis configuration..."
    link_one "$DOTFILES_DIR/.config/vis" "$HOME/.config/vis"
}

link_vim() {
    echo     "Linking Vim configuration..."
    link_one "$DOTFILES_DIR/.vimrc" "$HOME/.vimrc"
}

link_rofi() {
    echo     "Linking Rofi configuration..."
    link_one "$DOTFILES_DIR/.config/rofi" "$HOME/.config/rofi"
}

link_noctalia() {
    echo     "Linking Noctalia configuration..."
    link_one "$DOTFILES_DIR/.config/noctalia" "$HOME/.config/noctalia"
}

link_tofi() {
    echo     "Linking Tofi configuration..."
    link_one "$DOTFILES_DIR/.config/tofi" "$HOME/.config/tofi"
}

link_tmux() {
    echo     "Linking Tmux configuration..."
    mkdir -p "$HOME/.config/tmux"
    link_one "$DOTFILES_DIR/.config/tmux/tmux.conf" "$HOME/.config/tmux/tmux.conf"
}

link_flameshot() {
    echo     "Linking Flameshot configuration..."
    link_one "$DOTFILES_DIR/.config/flameshot" "$HOME/.config/flameshot"
}

link_wlogout() {
    echo     "Linking wlogout configuration..."
    link_one "$DOTFILES_DIR/.config/wlogout" "$HOME/.config/wlogout"
}

link_gitconfig() {
    echo     "Linking gitconfig..."
    link_one "$DOTFILES_DIR/.gitconfig" "$HOME/.gitconfig"
}

link_alacritty() {
    echo     "Linking Alacritty configuration..."
    link_one "$DOTFILES_DIR/.config/alacritty" "$HOME/.config/alacritty"
}

link_btop() {
    echo     "Linking btop configuration..."
    link_one "$DOTFILES_DIR/.config/btop" "$HOME/.config/btop"
}

link_envd() {
    echo     "Linking environment.d..."
    link_one "$DOTFILES_DIR/.config/environment.d" "$HOME/.config/environment.d"
}

link_pipewire() {
    echo     "Linking PipeWire configuration..."
    link_one "$DOTFILES_DIR/.config/pipewire" "$HOME/.config/pipewire"
}

link_st() {
    echo "Building suckless st (alpha patch, kitty/hypr theme)..."
    bash "$DOTFILES_DIR/st/build.sh"
}

link_fonts() {
    echo "Linking fonts..."
    local font_dir="$HOME/.local/share/fonts"
    mkdir -p "$font_dir"
    if [ -d "$DOTFILES_DIR/fonts" ]; then
        for font in "$DOTFILES_DIR/fonts"/*; do
            if [ -f "$font" ]; then
                link_one "$font" "$font_dir/$(basename "$font")"
            fi
        done
    else
        echo "Skipping (missing): $DOTFILES_DIR/fonts"
    fi
}

link_nob() {
    echo "Linking C Lib nob..."
    link_one "$DOTFILES_DIR/include" "/usr/include/nob.h"
}

enable_swaync() {
    # Personal lightweight notifications are swaync (not Noctalia).
    # Unmask (old deploy masked it), enable, and reload if running.
    echo "Enabling swaync (personal notifications)..."
    systemctl --user unmask swaync.service 2>/dev/null || true
    systemctl --user enable swaync.service 2>/dev/null || true
    systemctl --user restart swaync.service 2>/dev/null || true
}

disable_swaync() {
    # Legacy Noctalia-only helper. Kept for manual use; personal
    # sessions want `enable_swaync`, not this.
    echo "Disabling swaync (Noctalia owns notifications)..."
    systemctl --user stop swaync.service 2>/dev/null || true
    systemctl --user mask swaync.service 2>/dev/null || true
    pkill -x swaync 2>/dev/null || true
}

link_config() {
    link_dunst
    link_bash
    link_fastfetch
    link_cava
    link_mpv
    link_fish
    link_nushell
    link_helix
    link_hypr
    link_kitty
    link_nvim
    link_vis
    link_vim
    link_rofi
    link_waybar
    link_swaync
    link_noctalia
    link_tmux
    link_tofi
    link_flameshot
    link_wlogout
    link_gitconfig
    link_alacritty
    link_btop
    link_envd
    link_pipewire
    link_st
    link_fonts
    link_nob
    enable_swaync
}

link_bin() {
    echo "Linking binaries..."
    local files=(
        "wayland-boomer"
        "cg-timer"
        "cgm"
        "paru"
        "toofan"
        "wal"
        "wlogout"
        "yay"
    )

    for file in "${files[@]}"; do
        link_one "$DOTFILES_DIR/bin/$file" "/usr/bin/$file"
    done
}

link_all() {
    link_emacs
    link_config
    link_bin
}

usage() {
    cat <<EOF
Usage: $0 [command]

Options:
  -y, --yes   Auto-accept replacing existing files/dirs (no prompt)

Commands:
  all        Link all configurations (default)
  emacs      Link Emacs configuration
  config     Link all .config directories
  bin        Link all binaries to /usr/bin/
  fonts      Link all fonts to ~/.local/share/fonts
  dunst      Link Dunst configuration
  bash       Link Bash configuration
  fastfetch  Link fastfetch configuration
  cava       Link cava configuration
  mpv        Link mpv configuration
  fish       Link Fish configuration
  nushell    Link Nushell Configuration
  helix      Link Helix configuration
  hypr       Install personal Hyprland session (Hadi Hyprland, No Ryoku)
  waybar     Link Waybar configuration
  swaync     Link swaync configuration + enable the service
  kitty      Link Kitty configuration
  nvim         Link Neovim configuration
  vis          Link vis configuration (Emacs-style keybindings)
  vim          Link Vim configuration
  rofi       Link Rofi configuration
  noctalia   Link Noctalia configuration
  tofi       Link Tofi configuration
  flameshot  Link Flameshot configuration
  pipewire   Link PipeWire configuration
  wlogout    Link wlogout configuration (layout + style)
  gitconfig  Link gitconfig (cleaned single-identity + LFS filter)
  alacritty  Link Alacritty configuration
  btop       Link btop configuration
  envd       Link environment.d (Hyprland session env)
  st         Build suckless st terminal (kitty/hypr theme)
  tmux       Link Tmux configuration
  nob        Link Nob library
  noswaync   Mask swaync (Noctalia-only, legacy; personal uses swaync)

EOF
}

cmd="${1:-all}"
case "$cmd" in
    -y|--yes )
        force_yes=1
        cmd="${2:-all}"
        ;;
esac
case "$cmd" in
    all            ) link_all       ;;
    emacs          ) link_emacs     ;;
    config         ) link_config    ;;
    bin            ) link_bin       ;;
    fonts          ) link_fonts     ;;
    dunst          ) link_dunst     ;;
    bash           ) link_bash      ;;
    fastfetch      ) link_fastfetch ;;
    cava           ) link_cava      ;;
    mpv            ) link_mpv       ;;
    fish           ) link_fish      ;;
    nushell        ) link_nushell   ;;
    helix          ) link_helix     ;;
    hypr           ) link_hypr      ;;
    waybar         ) link_waybar    ;;
    swaync         ) { link_swaync; enable_swaync; } ;;
    kitty          ) link_kitty     ;;
    nvim           ) link_nvim      ;;
    vis            ) link_vis       ;;
    vim            ) link_vim       ;;
    rofi           ) link_rofi      ;;
    noctalia       ) link_noctalia  ;;
    tofi           ) link_tofi      ;;
    flameshot      ) link_flameshot ;;
    pipewire       ) link_pipewire  ;;
    wlogout        ) link_wlogout   ;;
    gitconfig      ) link_gitconfig ;;
    alacritty      ) link_alacritty ;;
    btop           ) link_btop      ;;
    envd           ) link_envd      ;;
    st             ) link_st        ;;
    tmux           ) link_tmux      ;;
    nob            ) link_nob       ;;
    noswaync       ) disable_swaync ;;
    -h|--help|help ) usage          ;;
    *              )
        usage
        exit 1
        ;;
esac
