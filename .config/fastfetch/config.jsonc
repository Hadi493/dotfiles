{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/fastfetch-emblem.png",
    "width": 28,
    "height": 14,
    "padding": {
      "left": 3,
      "right": 5,
      "top": 5
    }
  },
  "display": {
    "color": {
      "keys": "38;2;230;180;80",
      "separator": "#6B7B8E",
      "title": "#ffffff"
    },
    "key": {
      "width": 9
    },
    "percent": {
      "color": {
        "green": "#C5E665",
        "red": "#FF7B85",
        "yellow": "#E6B450"
      },
      "type": 9
    },
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;title}{user-name}{#}{#separator} @ {#}{#1;title}{host-name}{#}"
    },
    {
      "format": "{#keys}■{#} {#separator}HADI · a hand-built Arch Linux desktop{#}",
      "type": "custom"
    },
    "break",
    {
      "format": "{#keys}──{#} {#1;title}VITALS{#} {#38;2;54;54;82}──────────────────────────{#} ────",
      "type": "custom"
    },
    {
      "key": "CPU",
      "type": "cpu"
    },
    {
      "detectionMethod": "pci",
      "key": "GPU",
      "type": "gpu"
    },
    {
      "key": "MEMORY",
      "type": "memory"
    },
    {
      "key": "DISK",
      "type": "disk"
    },
    "break",
    {
      "format": "{#keys}──{#} {#1;title}SYSTEM{#} {#38;2;54;54;82}──────────────────────────{#} ────",
      "type": "custom"
    },
    {
      "key": "OS",
      "type": "os"
    },
    {
      "key": "KERNEL",
      "type": "kernel"
    },
    {
      "key": "WM",
      "type": "wm"
    },
    {
      "key": "SHELL",
      "type": "shell"
    },
    {
      "key": "PKGS",
      "type": "packages"
    },
    "break",
    {
      "format": "{#keys}──{#} {#1;title}SESSION{#} {#38;2;54;54;82}─────────────────────────{#} ────",
      "type": "custom"
    },
    {
      "key": "UPTIME",
      "type": "uptime"
    },
    {
      "key": "TERM",
      "type": "terminal"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
