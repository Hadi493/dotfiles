* {
    base:      #181818;
    mantle:    #0d0d0d;
    crust:     #0d0d0d;
    text:      #ffffff;
    subtext0:  #6B7B8E;
    subtext1:  #ffffff;
    surface0:  #1c1c2a;
    surface1:  #2a2a3e;
    surface2:  #363652;
    overlay0:  #6B7B8E;
    overlay1:  #6B7B8E;
    overlay2:  #95a99f;
    blue:      #6DCFFF;
    lavender:  #E0B8FF;
    sapphire:  #4AC8E6;
    sky:       #4AC8E6;
    teal:      #A8F0D8;
    green:     #C5E665;
    yellow:    #E6B450;
    gold:      #E6B450;
    peach:     #FFA375;
    maroon:    #FFA375;
    red:       #FF7B85;
    mauve:     #E0B8FF;
    pink:      #E0B8FF;
    flamingo:  #FFA375;
    rosewater: #ffffff;

    font: "Iosevka Nerd Font 15";
    border-radius: 8px;
}

configuration {
    show-icons: true;
    display-drun: "";
    display-run: "";
    display-filebrowser: "";
    display-window: "";
}

window {
    width: 1760px;
    height: 790px;
    transparency: "real";
    fullscreen: false;
    enabled: true;
    cursor: "default";
    spacing: 0px;
    border-radius: @border-radius;
    background-color: @base;
    border: 2px solid;
    border-color: @gold;
}

mainbox {
    enabled: true;
    spacing: 6px;
    padding: 7px;
    orientation: vertical;
    children: ["listbox", "inputbar"];
    background-color: transparent;
}

inputbar {
    enabled: true;
    padding: 12px;
    spacing: 8px;
    margin: 6px;
    background-color: @surface0;
    text-color: @text;
    border-radius: @border-radius;
    children: ["entry"];
}

entry {
    enabled: true;
    padding: 4px;
    text-color: inherit;
    cursor: text;
    placeholder: "Search wallpapers...";
    placeholder-color: @subtext0;
    background-color: transparent;
}

listbox {
    padding: 0px;
    spacing: 0px;
    orientation: vertical;
    children: ["listview"];
    background-color: transparent;
}

listview {
    padding: 2px;
    spacing: 0px;
    enabled: true;
    columns: 2;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    cursor: "default";
    background-color: transparent;
    border-radius: @border-radius;
}

element {
    orientation: vertical;
    enabled: true;
    spacing: 0px;
    padding: 0px;
    cursor: pointer;
    background-color: @base;
    color: @text;
    border-radius: @border-radius;
}

element selected.normal {
    background-color: @surface2;
    text-color: @gold;
    border: 0px;
}

element-icon {
    size: 670px;
    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.5;
    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
    font: "Iosevka Nerd Font 13";
}

error-message {
    padding: 15px;
    text-color: @red;
    background-color: @base;
    border-radius: @border-radius;
    children: ["textbox"];
}

textbox {
    text-color: inherit;
    background-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}
