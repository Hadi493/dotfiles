configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "Iosevka Nerd Font Mono 14";
    display-drun: "󰀻 Apps";
    display-run: " Run";
    display-window: "󰖯 Windows";
    terminal: "kitty";
    drun-display-format: "{name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: false;
    width: 600;
    lines: 12;
    columns: 1;
    fixed-num-lines: true;
    sort: true;
    sorting-method: "fzf";
    case-sensitive: false;
    cycle: true;
    hover-select: true;
    click-to-exit: true;
}

/* Gruber-Darker-Ayu Colors */
* {
    base:      #181818;
    mantle:    #0d0d0d;
    crust:     #0d0d0d;
    text:      #ffffff;
    subtext0:  #6B7B8E;
    subtext1:  #ffffff;
    surface0:  #1c1c2a;
    surface1:  #2a2a3e;
    surface2:  #363652;
    overlay0:  #6B7B8E;
    overlay1:  #6B7B8E;
    overlay2:  #95a99f;
    blue:      #6DCFFF;
    lavender:  #E0B8FF;
    sapphire:  #4AC8E6;
    sky:       #4AC8E6;
    teal:      #A8F0D8;
    green:     #C5E665;
    yellow:    #E6B450;
    gold:      #E6B450;
    peach:     #FFA375;
    maroon:    #FFA375;
    red:       #FF7B85;
    mauve:     #E0B8FF;
    pink:      #E0B8FF;
    flamingo:  #FFA375;
    rosewater: #ffffff;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 600px;
    border-radius: 16px;
    cursor: "default";
    background-color: @base;
    border: 2px solid;
    border-color: @gold;
}

mainbox {
    enabled: true;
    spacing: 10px;
    margin: 0px;
    padding: 15px;
    border: 0px solid;
    border-radius: 0px 0px 0px 0px;
    border-color: @surface1;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    enabled: true;
    spacing: 10px;
    margin: 0px;
    padding: 12px;
    border: 0px solid;
    border-radius: 8px;
    border-color: @surface1;
    background-color: @surface0;
    text-color: @text;
    children: [ "prompt", "entry" ];
}

prompt {
    enabled: true;
    background-color: @gold;
    text-color: @crust;
    padding: 8px 12px;
    border-radius: 6px;
    font: "Iosevka Nerd Font Mono Bold 14";
}

textbox-prompt-colon {
    enabled: true;
    expand: false;
    str: ":";
    background-color: inherit;
    text-color: inherit;
}

entry {
    enabled: true;
    background-color: transparent;
    text-color: @text;
    cursor: text;
    placeholder: "Search applications...";
    placeholder-color: @subtext0;
    padding: 8px 4px;
}

listview {
    enabled: true;
    columns: 1;
    lines: 12;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    
    spacing: 2px;
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    border-radius: 0px;
    border-color: @surface1;
    background-color: transparent;
    text-color: @text;
    cursor: "default";
}

scrollbar {
    handle-width: 5px;
    handle-color: @surface2;
    border-radius: 8px;
    background-color: @surface0;
}

element {
    enabled: true;
    spacing: 10px;
    margin: 0px;
    padding: 10px;
    border: 0px solid;
    border-radius: 8px;
    border-color: @surface1;
    background-color: transparent;
    text-color: @text;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @text;
}

element normal.urgent {
    background-color: @red;
    text-color: @crust;
}

element normal.active {
    background-color: @green;
    text-color: @crust;
}

element selected.normal {
    background-color: @surface2;
    text-color: @gold;
}

element selected.urgent {
    background-color: @red;
    text-color: @crust;
}

element selected.active {
    background-color: @green;
    text-color: @crust;
}

element alternate.normal {
    background-color: transparent;
    text-color: @text;
}

element alternate.urgent {
    background-color: @red;
    text-color: @crust;
}

element alternate.active {
    background-color: @green;
    text-color: @crust;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 28px;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

/* Optional: Custom colors for different modes */
mode-switcher{
    enabled: true;
    spacing: 10px;
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    border-radius: 0px;
    border-color: @surface1;
    background-color: transparent;
    text-color: @text;
}

button {
    padding: 8px;
    border: 0px solid;
    border-radius: 6px;
    border-color: @surface1;
    background-color: @surface0;
    text-color: @text;
    cursor: pointer;
}

button selected {
    background-color: @gold;
    text-color: @crust;
}
