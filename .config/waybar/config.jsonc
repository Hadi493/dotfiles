{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "margin": "6 10 0 10",
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/notification",
        "custom/clipboard",
        "network",
        "pulseaudio",
        "custom/mic",
        "cpu",
        "memory",
        "tray",
        "custom/updates",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "format": "{name}"
    },
    "clock": {
        "interval": 1,
        "format": "{:%I:%M %p}",
        "format-alt": "󰃮 {:%a %d %b}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#E6B450'><b>{}</b></span>",
                "days": "<span color='#F5CD98'>{}</span>",
                "weeks": "<span color='#6DCFFF'><b>W{}</b></span>",
                "weekdays": "<span color='#E0B8FF'><b>{}</b></span>",
                "today": "<span color='#C5E665'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "custom/notification": {
        "exec": "~/.config/waybar/scripts/notification_indicator.sh",
        "return-type": "json",
        "on-click": "swaync-client --toggle-panel",
        "on-click-right": "swaync-client --toggle-dnd",
        "tooltip": true
    },
    "custom/clipboard": {
        "format": "",
        "tooltip": "Clipboard history (Super+V)",
        "on-click": "~/dotfiles/.config/hypr/scripts/clipboard"
    },
    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid} · {ipaddr}",
        "tooltip-format-ethernet": "{ipaddr}",
        "on-click": "kitty -e nmtui",
        "interval": 10
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 2
    },
    "cpu": {
        "format": "󰘚 {usage}%",
        "interval": 3
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 10
    },
    "tray": {
        "icon-size": 18,
        "spacing": 6
    },
    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "interval": 3600,
        "format": "󰚰 {}",
        "on-click": "kitty -e yay -Syu"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": "Power menu",
        "on-click": "~/.config/waybar/scripts/wlogout.sh"
    },
    "custom/mic": {
        "exec": "~/.config/waybar/scripts/mic.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
        "tooltip": true
    }
}
