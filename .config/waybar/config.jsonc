{
    "layer": "top",
    "position": "top",
    "height": 0,
    "spacing": 6,
    "margin": "6 10 0 10",
    "modules-left": [
        "custom/separator",
        "hyprland/workspaces",
        "custom/separator",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "pulseaudio#microphone",
        "cpu",
        "memory",
        "disk",
        "custom/temperature",
        "custom/separator",
        "battery",
        "backlight",
        "custom/separator",
        "tray",
        "custom/updates",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "format": "{name}"
    },

    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true,
        "rewrite": {
            "(.*) - Brave": " $1",
            "(.*) - kitty": " $1",
            "(.*) - Code": "󰨞 $1",
            "(.*) - Nautilus": "󰉋 $1"
        }
    },

    "clock": {
        "interval": 1,
        "format": "{:%I:%M %p}",
        "format-alt": "󰃮 {:%a %d %b}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#E6B450'><b>{}</b></span>",
                "days": "<span color='#d4be98'>{}</span>",
                "weeks": "<span color='#7daea3'><b>W{}</b></span>",
                "weekdays": "<span color='#d3869b'><b>{}</b></span>",
                "today": "<span color='#a9b665'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ifname} via {gwaddr}",
        "interval": 10,
        "on-click": "kitty -e nmtui"
    },

    "cpu": {
        "format": "󰘚 {usage}%",
        "interval": 3,
        "tooltip": true
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "tooltip": true,
        "interval": 10
    },

    "disk": {
        "format": "󰋊 {percentage_used}%",
        "tooltip": true,
        "interval": 60
    },

    "custom/temperature": {
        "format": "󰔏 {}°C",
        "exec": "/home/hadi/.config/waybar/scripts/temperature.sh",
        "interval": 10,
        "on-click": "kitty -e s-tui"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂰 {volume}%",
        "format-bluetooth-muted": "󰂲 {icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰥰",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰄝",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 6
    },

    "custom/updates": {
        "format": "󰚰 {}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/updates.sh",
        "interval": 3600,
        "on-click": "kitty -e yay -Syu",
        "signal": 8
    },

    "custom/power": {
        "tooltip": true,
        "tooltip-format": "Power Menu",
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/wlogout.sh"
    },

    "custom/separator": {
        "format": "",
        "interval": "once",
        "tooltip": false
    }
}
