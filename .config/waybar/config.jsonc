{
    "layer": "top",
    "position": "top",
    "height": 0,
    "spacing": 0,
    "margin": "5 10 0 10",
    "modules-left": [
        "custom/separator",
        "hyprland/workspaces",
        "custom/separator"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/separator",
        "custom/network",
        "custom/audio",
        "custom/mic",
        "custom/cpu",
        "custom/memory",
        "custom/disk",
        "custom/uptime",
        "custom/temperature",
        "custom/separator",
        "tray",
        "custom/updates",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "format": "{name}"
    },

    "clock": {
        "interval": 1,
        "format": "{:%I:%M %p}",
        "format-alt": "󰃮 {:%a %d %b}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#E6B450'><b>{}</b></span>",
                "days": "<span color='#F5CD98'>{}</span>",
                "weeks": "<span color='#6DCFFF'><b>W{}</b></span>",
                "weekdays": "<span color='#E0B8FF'><b>{}</b></span>",
                "today": "<span color='#C5E665'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/network": {
        "exec": "~/.config/waybar/scripts/network.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "kitty -e nmtui"
    },

    "custom/audio": {
        "exec": "~/.config/waybar/scripts/audio.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
    },

    "custom/mic": {
        "exec": "~/.config/waybar/scripts/mic.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%"
    },

    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu.sh",
        "interval": 3,
        "format": "󰘚 {}%",
        "tooltip": true
    },

    "custom/memory": {
        "exec": "~/.config/waybar/scripts/memory.sh",
        "interval": 10,
        "format": "󰍛 {}%",
        "tooltip": true
    },

    "custom/disk": {
        "exec": "~/.config/waybar/scripts/disk.sh",
        "interval": 60,
        "format": "󰋊 {}%",
        "tooltip": true
    },

    "custom/uptime": {
        "exec": "~/.config/waybar/scripts/uptime.sh",
        "interval": 30,
        "tooltip": true
    },

    "custom/temperature": {
        "exec": "~/.config/waybar/scripts/temperature.sh",
        "interval": 10,
        "format": "󰔏 {}°C",
        "on-click": "kitty -e s-tui"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 6
    },

    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "interval": 3600,
        "format": "󰚰 {}",
        "on-click": "kitty -e yay -Syu"
    },

    "custom/power": {
        "tooltip": true,
        "tooltip-format": "Power Menu",
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/wlogout.sh"
    },

    "custom/separator": {
        "format": "",
        "interval": "once",
        "tooltip": false
    }
}
