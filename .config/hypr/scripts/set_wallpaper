#!/bin/bash
WALLPAPER="$1"
[ -z "$WALLPAPER" ] && { echo "Usage: $0 <image>"; exit 1; }
[ ! -f "$WALLPAPER" ] && { echo "File not found: $WALLPAPER"; exit 1; }

RES=$(hyprctl -j monitors 2>/dev/null | jq -r 'if length > 0 then "\(.[0].width)x\(.[0].height)" else "1920x1080" end')

if [[ "$WALLPAPER" == *.gif ]]; then
    pkill -x mpvpaper
    mpvpaper -o "no-audio --loop-file=inf" "*" "$WALLPAPER" &
    exit 0
fi

CACHE="/tmp/wallpaper_$(basename "$WALLPAPER" | sed 's/\.[^.]*$//').bmp"
if [ ! -f "$CACHE" ]; then
    magick "$WALLPAPER" -resize "$RES!" -blur 0x10 BMP:- | \
        magick - \( "$WALLPAPER" -resize "$RES" \) -gravity center -composite "$CACHE"
fi

pkill -x swaybg
swaybg -i "$CACHE" -m fill &
