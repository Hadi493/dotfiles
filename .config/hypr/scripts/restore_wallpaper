#!/bin/bash
# Re-apply the wallpaper saved from the last successful set.
# (Don't kill the running painter until we know we have something to show.)

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/wallpaper.sh"

if [ -f "$WP_CACHE_FILE" ]; then
    WALLPAPER_PATH=$(tr -d '\r\n' < "$WP_CACHE_FILE")
    if [ -n "$WALLPAPER_PATH" ] && [ -f "$WALLPAPER_PATH" ]; then
        "$WP_SET_SCRIPT" "$WALLPAPER_PATH"
    fi
fi
