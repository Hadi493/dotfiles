#!/bin/bash
# Rotate active monitor - closest to "rotate active window" possible in Hyprland
# Hyprland can't rotate a single live window (wl_surface) at arbitrary angle.
# This rotates the entire monitor the active window is on, bound to a key.
# Usage: rotate-active-monitor [next|0|1|2|3|normal|right|left|inverted|reset]

set -e

if ! command -v jq >/dev/null 2>&1; then
  notify-send -u critical "rotate-active-monitor" "jq not found - install jq"
  exit 1
fi

get_focused_monitor_json() {
  hyprctl monitors -j | jq -c '.[] | select(.focused==true)'
}

MON_JSON=$(get_focused_monitor_json)

if [ -z "$MON_JSON" ] || [ "$MON_JSON" = "null" ]; then
  notify-send -u critical "rotate-active-monitor" "No focused monitor found"
  exit 1
fi

NAME=$(echo "$MON_JSON" | jq -r '.name')
CUR_TRANSFORM=$(echo "$MON_JSON" | jq -r '.transform')
WIDTH=$(echo "$MON_JSON" | jq -r '.width')
HEIGHT=$(echo "$MON_JSON" | jq -r '.height')
X=$(echo "$MON_JSON" | jq -r '.x')
Y=$(echo "$MON_JSON" | jq -r '.y')
SCALE=$(echo "$MON_JSON" | jq -r '.scale')
REFRESH=$(echo "$MON_JSON" | jq -r '.refreshRate')

# refreshRate is like 60.049, format to leave 2 decimals without trailing zeros issues
# Hyprland accepts e.g. 1920x1080@60.05 - we keep as is but strip to 2 decimals
REFRESH_FMT=$(printf "%.2f" "$REFRESH" 2>/dev/null || echo "$REFRESH")

ARG="${1:-next}"

case "$ARG" in
  next|n|cycle)
    NEW=$(( (CUR_TRANSFORM + 1) % 4 ))
    ;;
  0|normal|0deg)
    NEW=0
    ;;
  1|90|right|90deg)
    NEW=1
    ;;
  2|180|inverted|180deg|flip)
    NEW=2
    ;;
  3|270|left|270deg)
    NEW=3
    ;;
  reset)
    NEW=0
    ;;
  *)
    echo "Usage: $0 [next|0|1|2|3|normal|right|left|inverted]"
    exit 1
    ;;
esac

# Hyprland 0.56+ with hyprland.lua uses Lua API, legacy `keyword monitor` fails.
# Try Lua eval first (works for both eDP-1/HDMI, preserves mode/pos automatically).
# Fallback to legacy keyword for old configs.
MON_SPEC="${NAME},${WIDTH}x${HEIGHT}@${REFRESH_FMT},${X}x${Y},${SCALE},transform,${NEW}"
FALLBACK_SPEC="${NAME},preferred,auto,${SCALE},transform,${NEW}"

# Save current gaps to restore after monitor reconfiguration (Noctalia/Hyprland can reload theme.lua on monitor change and reset gaps)
# gaps_in/out use css "5 5 5 5" format when set via hl.config, not .int
GAPS_IN=$(hyprctl -j getoption general:gaps_in 2>/dev/null | jq -r '.css // "5 5 5 5"' | awk '{print $1}')
GAPS_OUT=$(hyprctl -j getoption general:gaps_out 2>/dev/null | jq -r '.css // "10 10 10 10"' | awk '{print $1}')
BORDER=$(hyprctl -j getoption general:border_size 2>/dev/null | jq -r '.int // 0')
ROUNDING=$(hyprctl -j getoption decoration:rounding 2>/dev/null | jq -r '.int // 0')
[ -z "$GAPS_IN" ] && GAPS_IN=5
[ -z "$GAPS_OUT" ] && GAPS_OUT=10
# Save Noctalia bar visibility (best-effort) - NOTE: `noctalia msg bar-hide` is currently no-op in this Noctalia build
# Tested: bar-hide, bar-hide default, bar-hide default HDMI-A-2, bar-toggle etc all return ok but bar stays (layers still 1)
# So we save state but will not auto-restore via IPC; use persistent config instead (see 10-bar.toml auto_hide)
if hyprctl layers -j 2>/dev/null | jq -e --arg mon "$NAME" '.[$mon].levels."2" | map(select(.namespace=="noctalia-bar-default")) | length > 0' >/dev/null 2>&1; then
  BAR_VISIBLE=1
else
  if hyprctl layers -j 2>/dev/null | jq -e --arg mon "$NAME" '.[$mon] | not' >/dev/null 2>&1; then
    BAR_VISIBLE=1
  else
    BAR_VISIBLE=0
  fi
fi

if hyprctl eval "hl.monitor({output=\"${NAME}\", transform=${NEW}})" 2>&1 | grep -qv "error"; then
  # eval succeeded, transform applied via Lua
  :
else
  if hyprctl keyword monitor "$MON_SPEC" 2>&1 | grep -qv "can't work with non-legacy"; then
    :
  else
    hyprctl keyword monitor "$FALLBACK_SPEC" 2>&1 || hyprctl eval "hl.monitor({output=\"${NAME}\", transform=${NEW}})"
  fi
fi

# Give Hyprland/Noctalia time to re-apply monitor and (potentially) reload config which resets gaps/bar
sleep 0.5

# Restore gaps/border/rounding that may have been reset by theme reload
if [ -n "$GAPS_IN" ] && [ -n "$GAPS_OUT" ]; then
  hyprctl eval "hl.config({ general = { gaps_in = $GAPS_IN, gaps_out = $GAPS_OUT, border_size = $BORDER }, decoration = { rounding = $ROUNDING } })" >/dev/null 2>&1 || true
fi

# Restore Noctalia bar state - IPC currently broken (bar-hide no-op), so do not auto-restore
# If you hid bar via bar-hide/bar-toggle before rotate, it WILL reappear after transform (Noctalia recreates layer)
# For persistent hide, set auto_hide=true in ~/.config/noctalia/modules/10-bar.toml and `noctalia msg config-reload`
# Best-effort try anyway (will succeed when Noctalia fixes IPC):
if [ "$BAR_VISIBLE" = "0" ]; then
  for i in 1 2 3; do noctalia msg bar-hide 2>/dev/null; sleep 0.3; done || true
fi

# Notifications - disabled by default because Noctalia's notification center can look like a toggle
# Use hyprctl notify (Hyprland OSD) instead of notify-send to avoid Noctalia flicker
case "$NEW" in
  0) LABEL="0° normal" ;;
  1) LABEL="90° right" ;;
  2) LABEL="180° inverted" ;;
  3) LABEL="270° left" ;;
esac

# Hyprland built-in notification (does not trigger Noctalia panel)
hyprctl notify 1 1200 "0xff88ccff" "  $NAME -> $LABEL  " 2>/dev/null || true
# If you prefer Noctalia/dunst, uncomment:
# notify-send -t 1200 "Monitor $NAME" "Rotated to $LABEL (transform $NEW)" 2>/dev/null || true

echo "Rotated $NAME: $CUR_TRANSFORM -> $NEW ($MON_SPEC)"
