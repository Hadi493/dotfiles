#!/bin/bash

# ============================================================
# workspace-setup.sh - Hyprland Workspace Auto-Setup Script
# ============================================================
# Edit the LAYOUT array below to customize your workspace layout.
#
# Format: "workspace|title|command|flags"
#   workspace - workspace number (1-10)
#   title     - any label (for readability only)
#   command   - command to execute
#   flags:
#     g - enable group/tab mode (first window starts the group)
#
# Examples:
#   "1|kitty|kitty|g"    ← workspace 1: kitty, starts group
#   "1|emacs|emacs|"     ← workspace 1: emacs joins kitty's group
#   "2|firefox|firefox|" ← workspace 2: firefox
# ============================================================

LAYOUT=(
  "1|kitty|kitty|g"
  "1|emacs|emacs|"
  "2|firefox|firefox|"
  "3|Discord|brave-origin --profile-directory=Default --app=https://discord.com/channels/@me|"
)

# ============================================================
# Don't edit below this line
# ============================================================

sleep 2

window_count_on_ws() {
  hyprctl clients | grep -c "workspace: $1 "
}

wait_for_new_window() {
  local ws="$1" before="$2" i=0
  while [ "$i" -lt 40 ]; do
    [ "$(window_count_on_ws "$ws")" -gt "$before" ] && { sleep 0.5; return 0; }
    sleep 0.5
    i=$((i + 1))
  done
}

unfloat() {
  hyprctl activewindow | grep -q "floating: 1" && { hyprctl dispatch togglefloating; sleep 0.3; }
}

for entry in "${LAYOUT[@]}"; do
  IFS='|' read -r ws title cmd flags <<< "$entry"

  hyprctl dispatch workspace "$ws"
  sleep 0.5

  before=$(window_count_on_ws "$ws")

  hyprctl dispatch exec "$cmd"

  wait_for_new_window "$ws" "$before"

  if [[ "$flags" == *"g"* ]]; then
    unfloat
    hyprctl dispatch togglegroup
    sleep 0.3
  fi
done

hyprctl dispatch workspace 1
