#!/bin/bash
# Control external (HP) monitor via DDC/CI over the ddcutil-service D-Bus API.
# Usage: monitor [brightness|contrast] [up|down]
#        monitor input [next]
#        monitor input set <input-value>
#
# Brightness shows the same island OSD as scripts/volume: eight block cells, an
# icon by level, replace-in-place. A DDC write takes ~150 ms, so the value we
# just wrote is cached for a moment and concurrent presses are serialised -
# otherwise key repeat re-reads the same brightness and the panel looks stuck.

set -u

DISPLAY_NUM=1
DBUS_DEST=(--session --dest com.ddcutil.DdcutilService --object-path /com/ddcutil/DdcutilObject)

MODEv="${1:-brightness}"
DIR="${2:-up}"

case "$MODEv" in
  brightness) VCP=0x10 ;;
  contrast)   VCP=0x12 ;;
  input)      VCP=0x60 ;;
  *) echo "usage: monitor [brightness|contrast|input] [up|down|next|set <value>]" >&2
     exit 1 ;;
esac

STEP=5

vcp_get() {
  # echoes current value; args: vcp_hex
  gdbus call "${DBUS_DEST[@]}" --method com.ddcutil.DdcutilInterface.GetVcp "$DISPLAY_NUM" '' "$1" 0 2>/dev/null \
    | sed -E 's/^\(uint16 ([0-9]+).*/\1/'
}

vcp_set() {
  gdbus call "${DBUS_DEST[@]}" --method com.ddcutil.DdcutilInterface.SetVcp "$DISPLAY_NUM" '' "$1" "$2" 0 2>/dev/null >/dev/null
}

# --- DDC state ---------------------------------------------------------------
# Serialise presses and remember the value we wrote: GetVcp can keep answering
# with the old value for a few hundred ms after SetVcp, so a key held down
# would otherwise stay on one step. One lock for the whole panel, one state
# file per VCP.
statedir="${XDG_RUNTIME_DIR:-$HOME/.cache}"
mkdir -p "$statedir"
state="$statedir/monitor-$MODEv.state"
CACHE_MS=1500
now_ms() { date +%s%3N; }
# The summary doubles as the OSD label and the failure message's first line.
case "$MODEv" in
  brightness) LABEL=Brightness; ICON=weather-clear ;;
  contrast)   LABEL=Contrast;   ICON=contrast ;;
  input)      LABEL="Monitor input"; ICON=video-display ;;
esac

if [ "$MODEv" != input ]; then
  exec 9>"$statedir/monitor-ddc.lock"
  # Never wedge the keybind on a stale lock.
  flock -w 1 9 || true
fi

cur=$(vcp_get "$VCP")
if [ -z "$cur" ]; then
  if [ "$MODEv" != input ]; then
    notify-send -t 1500 -u critical -i video-display \
      "$LABEL" "no DDC reply from the monitor"
    exit 1
  fi
  cur=50
fi

if [ "$MODEv" != input ] && [ -f "$state" ]; then
  read -r stamp cached <"$state" || true
  if [ -n "${cached:-}" ] && (($(now_ms) - stamp < CACHE_MS)); then
    cur=$cached
  fi
fi

case "$DIR" in
  up)
    new=$((cur + STEP)); [ "$new" -gt 100 ] && new=100 ;;
  down)
    new=$((cur - STEP)); [ "$new" -lt 0 ] && new=0 ;;
  set)
    new="${3:-$cur}" ;;
  next)
    new=$([ "$cur" = 15 ] && echo 17 || echo 15) ;;
  *)
    new="$cur" ;;
esac

set_ok=1
vcp_set "$VCP" "$new" || set_ok=0
if [ "$MODEv" != input ] && [ "$set_ok" = 1 ]; then
  printf '%s %s\n' "$(now_ms)" "$new" >"$state"
fi

# --- OSD ---------------------------------------------------------------------
# swaync has no OSD bar, so the body carries one: eight cells of block glyphs.
# Iosevka (the OSD font) is monospace, so the bar keeps a fixed width.
BAR_CELLS=8
bar() {
  local filled=$1 i out=""
  for ((i = 0; i < BAR_CELLS; i++)); do
    if ((i < filled)); then out+="▰"; else out+="▱"; fi
  done
  printf '%s' "$out"
}

level_osd() { # $1 = value 0-100, $2 = 1 to turn red at zero
  local value=$1 critical_at_zero=${2:-0} cells accent=()
  cells=$(((value * BAR_CELLS + 50) / 100))   # round to the nearest cell
  if ((value > 0 && cells == 0)); then cells=1; fi   # 1-6 % still lights one
  # Both levels share one tag, so brightness and contrast replace each other
  # instead of stacking: one card per panel, like a hardware OSD.
  # Brightness 0 is red like a muted sink; contrast 0 is just flat, not an alarm.
  if ((value == 0 && critical_at_zero == 1)); then accent=(-u critical); fi
  notify-send -t 900 "${accent[@]}" -i "$ICON" \
    -h string:x-canonical-private-synchronous:monitor \
    "$LABEL" "$(bar "$cells")  ${value}%"
}

case "$MODEv" in
  input)
    if [ "$new" = 15 ]; then label="DP"; else label="HDMI"; fi
    notify-send -t 900 -i "$ICON" -h string:x-canonical-private-synchronous:monitor \
      "$LABEL" "${label:-changed}"
    ;;
  brightness | contrast)
    if [ "$set_ok" = 0 ]; then
      notify-send -t 1500 -u critical -i video-display \
        "$LABEL" "DDC write failed"
      exit 1
    fi
    if [ "$MODEv" = brightness ]; then
      level_osd "$new" 1
    else
      level_osd "$new" 0
    fi
    ;;
esac
