#!/bin/bash

WALLPAPER_DIR="$HOME/Pictures/wallpapers/"
GIT_REPO="$WALLPAPER_DIR"
ROFI_THEME="$HOME/.config/rofi/wallpaper.rasi"
AUTO="$HOME/.config/hypr/scripts/wallpaper_auto"

if [ ! -d "$WALLPAPER_DIR" ]; then
    rofi -e "Wallpaper directory not found: $WALLPAPER_DIR"
    exit 1
fi

# Launcher mode (run directly from Hyprland): start rofi script mode with $0
if [ -z "${ROFI_RETV:-}" ]; then
    exec rofi -show wpsel -modes "wpsel:$0" -theme "$ROFI_THEME"
fi

list_wallpapers() {
    find "$WALLPAPER_DIR" -type f \
        \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.gif" -o -iname "*.webp" \) \
        -print0 | while IFS= read -r -d $'\0' w; do
        printf '%s\x00icon\x1f%s\x1finfo\x1f%s\n' "$(basename "$w")" "$w" "$w"
    done
}

set_wallpaper() {
    local path="$1"
    swaybg -i "$path" -m fit
    echo "$path" > "$HOME/.cache/last_wallpaper.path"
    killall -SIGUSR2 waybar 2>/dev/null
    swaync-client --reload 2>/dev/null || true
    notify-send -t 1000 "Wallpaper changed" "$(basename "$path")"
}

switch_branch() {
    local branch="$1"
    if git -C "$GIT_REPO" rev-parse --verify "refs/heads/$branch" >/dev/null 2>&1; then
        git -C "$GIT_REPO" switch "$branch"
        notify-send -t 1000 "Branch switched" "$(basename "$GIT_REPO"): $branch"
        return 0
    fi
    return 1
}

case "${ROFI_RETV:-}" in
    0)
        list_wallpapers
        ;;
    1)
        path="${ROFI_INFO:-}"
        if [ -n "$path" ] && [ -f "$path" ]; then
            set_wallpaper "$path"
        else
            switch_branch "$1" || notify-send -t 2000 "No such branch" "$1"
        fi
        ;;
    2)
        input="$1"
        case "$input" in
            /auto*)
                interval="${input#/auto}"
                interval="${interval# }"
                "$AUTO" start "${interval:-5m}"
                ;;
            /stop*)
                "$AUTO" stop
                ;;
            /chbranch*)
                echo -en "\x00prompt\x1fSwitch branch\n"
                git -C "$GIT_REPO" branch --format='%(refname:short)'
                ;;
            /)
                notify-send -t 2000 "Commands" "/auto <interval> · /stop · /chbranch · /<branch>"
                ;;
            /*)
                branch="${input#/}"
                switch_branch "$branch" || notify-send -t 2000 "No such branch" "$branch"
                ;;
            *)
                if [ -f "$WALLPAPER_DIR/$input" ]; then
                    set_wallpaper "$WALLPAPER_DIR/$input"
                fi
                ;;
        esac
        ;;
esac
exit 0
