#!/bin/bash
# Rofi script-mode wallpaper/branch picker.

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/wallpaper.sh"

GIT_REPO="$WP_DIR"

if [ ! -d "$WP_DIR" ]; then
    rofi -e "Wallpaper directory not found: $WP_DIR"
    exit 1
fi

# Launcher mode (run directly from Hyprland): start rofi script mode with $0
if [ -z "${ROFI_RETV:-}" ]; then
    exec rofi -show wpsel -modes "wpsel:$0" -theme "$WP_ROFI_THEME"
fi

list_wallpapers() {
    wp_list | while IFS= read -r -d $'\0' w; do
        printf '%s\x00icon\x1f%s\x1finfo\x1f%s\n' "$(basename "$w")" "$w" "$w"
    done
}

switch_branch() {
    local branch="$1"
    if git -C "$GIT_REPO" rev-parse --verify "refs/heads/$branch" >/dev/null 2>&1; then
        git -C "$GIT_REPO" switch "$branch"
        notify-send -t 1000 "Branch switched" "$(basename "$GIT_REPO"): $branch"
        return 0
    fi
    return 1
}

case "${ROFI_RETV:-}" in
    0)
        list_wallpapers
        ;;
    1)
        path="${ROFI_INFO:-}"
        if [ -n "$path" ] && [ -f "$path" ]; then
            wp_apply "$path"
        else
            switch_branch "$1" >/dev/null 2>&1 || notify-send -t 2000 "No such branch" "$1"
        fi
        ;;
    2)
        input="$1"
        case "$input" in
            /auto*)
                interval="${input#/auto}"
                interval="${interval# }"
                "$WP_AUTO_SCRIPT" start "${interval:-5m}" >/dev/null 2>&1 </dev/null
                ;;
            /stop*)
                "$WP_AUTO_SCRIPT" stop >/dev/null 2>&1
                ;;
            /fill*)
                wp_use_fill
                wp_reapply
                ;;
            /fit*)
                wp_use_fit
                wp_reapply
                ;;
            /noblur*|/no-blur*)
                WP_BLUR="0"; wp_save_state
                wp_reapply
                ;;
            /blur*)
                WP_BLUR="1"; wp_save_state
                wp_reapply
                ;;
            /chbranch*)
                echo -en "\x00prompt\x1fSwitch branch\n"
                git -C "$GIT_REPO" branch --format='%(refname:short)'
                ;;
            /)
                notify-send -t 2000 "Commands" "/fill · /fit · /blur · /noblur · /auto <interval> · /stop · /chbranch · /<branch>"
                ;;
            /*)
                branch="${input#/}"
                switch_branch "$branch" >/dev/null 2>&1 || notify-send -t 2000 "No such branch" "$branch"
                ;;
            *)
                if [ -f "$WP_DIR/$input" ]; then
                    wp_apply "$WP_DIR/$input"
                fi
                ;;
        esac
        ;;
esac
exit 0
