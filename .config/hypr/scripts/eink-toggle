#!/bin/bash
# E-INK mode toggle for Hyprland - SOFT paper feel (easy on eyes)
# Toggles: grayscale paper shader + warm 4500K + no animations + full opacity
# Usage: eink-toggle [on|off|toggle|strong] (default toggle)
#   strong = high-contrast version (eink.frag), default = soft (eink-soft.frag)
#
# Colour temperature goes through hyprsunset (native Hyprland IPC) and shares
# its state file with scripts/color_temp and scripts/night_mode, so the three
# stay in sync.

SOFT_SHADER="$HOME/.config/hypr/shaders/eink-soft.frag"
STRONG_SHADER="$HOME/.config/hypr/shaders/eink.frag"
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/hypr-color-temp"
EINK_TEMP=4500
DAY_TEMP=6500

current_shader() {
  hyprctl getoption decoration:screen_shader 2>&1 | grep -E '^str:' | cut -d' ' -f2-
}

set_temp() {
  local temp=$1
  if hyprctl hyprsunset temperature "$temp" >/dev/null 2>&1; then
    printf '%s\n' "$temp" > "$STATE"
  else
    notify-send -u critical "E-ink" "hyprsunset is not running"
  fi
}

enable_eink() {
  local shader="${1:-$SOFT_SHADER}"
  [ -f "$shader" ] || shader="$SOFT_SHADER"
  hyprctl eval "hl.config({ decoration = { screen_shader = \"$shader\" } })" >/dev/null 2>&1
  hyprctl eval 'hl.config({ animations = { enabled = false } })' >/dev/null 2>&1
  hyprctl eval 'hl.config({ decoration = { active_opacity = 1.0, inactive_opacity = 1.0 } })' >/dev/null 2>&1
  set_temp "$EINK_TEMP"
  notify-send -t 1500 "E-ink mode" "ON soft — paper (4500K)"
}

disable_eink() {
  hyprctl eval 'hl.config({ decoration = { screen_shader = "" } })' >/dev/null 2>&1
  hyprctl eval 'hl.config({ animations = { enabled = true } })' >/dev/null 2>&1
  hyprctl eval 'hl.config({ decoration = { active_opacity = 1.0, inactive_opacity = 1.0 } })' >/dev/null 2>&1
  set_temp "$DAY_TEMP"
  notify-send -t 1500 "E-ink mode" "OFF — full color"
}

case "$1" in
  on) enable_eink "$SOFT_SHADER" ;;
  strong) enable_eink "$STRONG_SHADER" ;;
  off) disable_eink ;;
  *)
    SHADER_NOW=$(current_shader)
    if [ -z "$SHADER_NOW" ] || [ "$SHADER_NOW" = "[[EMPTY]]" ]; then
      enable_eink "$SOFT_SHADER"
    else
      disable_eink
    fi
    ;;
esac
