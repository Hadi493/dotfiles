#!/bin/bash
# Adjust the display colour temperature via hyprsunset (Hyprland native).
# Usage: color_temp warmer | cooler | reset | [kelvin]
#
# hyprsunset has no readable property, so the last value is kept in a small
# state file to make warmer/cooler steps relative.
set -u

STATE="${XDG_CACHE_HOME:-$HOME/.cache}/hypr-color-temp"
MIN_TEMP=3500
MAX_TEMP=7000
DAY_TEMP=6500
STEP=400

CURRENT=$(cat "$STATE" 2>/dev/null || echo "$DAY_TEMP")
case "$CURRENT" in ''|*[!0-9]*) CURRENT=$DAY_TEMP ;; esac

case "${1:-}" in
  warmer) NEW=$((CURRENT - STEP)) ;;
  cooler) NEW=$((CURRENT + STEP)) ;;
  reset)  NEW=$DAY_TEMP ;;
  *)
    if [ "${1:-}" -eq "${1:-}" ] 2>/dev/null; then NEW=$1; else NEW=$CURRENT; fi
    ;;
esac

[ "$NEW" -lt "$MIN_TEMP" ] && NEW=$MIN_TEMP
[ "$NEW" -gt "$MAX_TEMP" ] && NEW=$MAX_TEMP

if hyprctl hyprsunset temperature "$NEW" >/dev/null 2>&1; then
    printf '%s\n' "$NEW" > "$STATE"
    notify-send -t 1200 "Color temperature" "${NEW}K"
else
    notify-send -u critical "Color temperature" "hyprsunset is not running"
fi
echo "$NEW"
