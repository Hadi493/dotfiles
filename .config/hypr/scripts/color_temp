#!/bin/bash
# Adjust/warm the display color temperature via wl-gammarelay-rs.
# Usage: color_temp warmer | cooler | [temp-kelvin]
BUS=rs.wl-gammarelay
IFACE=rs.wl.gammarelay
MIN_TEMP=3500
MAX_TEMP=7000
DAY_TEMP=6500
STEP=400

CURRENT=$(busctl --user get-property "$BUS" / "$IFACE" Temperature 2>/dev/null | awk '{print $2}')
[ -z "$CURRENT" ] && CURRENT=$DAY_TEMP

case "$1" in
  warmer) NEW=$((CURRENT - STEP)); [ "$NEW" -lt "$MIN_TEMP" ] && NEW=$MIN_TEMP ;;
  cooler) NEW=$((CURRENT + STEP)); [ "$NEW" -gt "$MAX_TEMP" ] && NEW=$MAX_TEMP ;;
  *)
    if [ "$1" -eq "$1" ] 2>/dev/null; then NEW=$1; else NEW=$DAY_TEMP; fi
    [ "$NEW" -lt "$MIN_TEMP" ] && NEW=$MIN_TEMP
    [ "$NEW" -gt "$MAX_TEMP" ] && NEW=$MAX_TEMP ;;
esac

busctl --user set-property "$BUS" / "$IFACE" Temperature q "$NEW" 2>/dev/null
echo "$NEW"
notify-send -t 1200 "Color temperature" "${NEW}K"