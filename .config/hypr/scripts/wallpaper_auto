#!/bin/bash
# Rotate wallpapers on an interval; daemonizes via a PID file.

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/wallpaper.sh"

start() {
    local interval_sec
    interval_sec=$(wp_parse_interval "${1:-}")
    if ! [[ "$interval_sec" =~ ^[0-9]+$ ]] || [ "$interval_sec" -le 0 ]; then
        interval_sec=300
    fi

    wp_auto_stop >/dev/null 2>&1 || true

    mapfile -d '' wallpapers < <(wp_list)

    if [ "${#wallpapers[@]}" -eq 0 ]; then
        notify-send -t 2000 "Auto wallpaper" "No wallpapers found"
        exit 1
    fi

    notify-send -t 2000 "Auto wallpaper rotation started" "every ${1:-5m}"

    (
        trap 'exit 0' TERM
        while true; do
            for wp in "${wallpapers[@]}"; do
                if "$WP_SET_SCRIPT" "$wp" >/dev/null 2>&1; then
                    wp_persist "$wp"
                fi
                killall -SIGUSR2 waybar 2>/dev/null
                sleep "$interval_sec"
            done
        done
    ) >/dev/null 2>&1 < /dev/null &
    disown
    echo $! > "$WP_PIDFILE"
}

case "${1:-}" in
    start) start "${2:-5m}" ;;
    stop)  wp_auto_stop ;;
    *) echo "Usage: $0 start <interval (e.g. 5s/5m/5h)> | stop" ;;
esac
