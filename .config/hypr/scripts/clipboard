#!/usr/bin/env bash
# Clipboard manager: pinned entries + cliphist history, with image thumbnails.
#   Super+V       -> clip history + pins; Enter copies immediately
#   Super+Alt+V   -> manage: copy / pin / unpin / delete / clear history
#   Super+Shift+V -> pass (password store)
#
# Rows are emitted in Rofi's extended dmenu protocol (<text>\0icon\x1f<icon>)
# so fuzzel can render a thumbnail for image entries.  fuzzel's --index gives
# the selected row number (0-based), which maps 1:1 onto the key file.
set -u

PIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/cliphist-pinned"
THUMB_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cliphist-thumbs"
FUZZEL="${FUZZEL:-$HOME/.config/fuzzel/fuzzel.ini}"
mkdir -p "$PIN_DIR" "$THUMB_DIR"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
map="$tmpdir/map"
display="$tmpdir/display"

file_mime() { file -b --mime-type "$1" 2>/dev/null || echo application/octet-stream; }

file_info() {
    local f="$1" mime dims p
    mime=$(file_mime "$f")
    case "$mime" in
        image/*)
            dims=$(magick identify -format '%wx%h' "$f" 2>/dev/null || true)
            [ -n "$dims" ] && printf 'Image %s' "$dims" || printf 'Image'
            ;;
        text/*|application/json|application/xml|application/javascript)
            p=$(head -c 80 "$f"); p=${p//$'\n'/ }; p=${p//$'\t'/ }; p=${p//[[:cntrl:]]/}; printf '%s' "$p"
            ;;
        *) printf '%s' "$mime" ;;
    esac
}

pin_icon() {
    local f="$1" mime
    mime=$(file_mime "$f")
    case "$mime" in
        image/*) printf '%s' "$f" ;;
        *)       printf '%s' "bookmarks-bookmarked" ;;
    esac
}

pin_copy() {
    local f="$1" mime
    mime=$(file_mime "$f")
    wl-copy --type "$mime" < "$f"
}

copy_key() {
    local key="$1" tmpf mime f
    case "$key" in
        pin:*)
            f="$PIN_DIR/${key#pin:}"
            [ -f "$f" ] || { notify-send -t 2000 cliphist "pinned entry missing"; return; }
            pin_copy "$f"
            ;;
        hist:*)
            tmpf="$tmpdir/clip.bin"
            printf '%s' "${key#hist:}" | cliphist decode > "$tmpf" 2>/dev/null || return
            mime=$(file_mime "$tmpf")
            wl-copy --type "$mime" < "$tmpf"
            ;;
    esac
}

pin_entry() {
    local id="$1" out="$2" name
    printf '%s' "$id" | cliphist decode > "$out" 2>/dev/null || return 1
    [ -s "$out" ] || return 1
    name=$(sha1sum < "$out" | cut -c1-40)
    cp "$out" "$PIN_DIR/$name"
}

# row <text> <icon> <key>: emit a display row and record its key.
row() {
    printf '%s\0icon\x1f%s\n' "$1" "$2" >> "$display"
    printf '%s\n' "$3" >> "$map"
}

build_list() {
    local manage="${1:-}" f hash preview content id dims thumb icon
    : > "$map"
    : > "$display"

    if [ "$manage" = "manage" ]; then
        row "Clear history" "edit-clear" "action:clear"
    fi

    # ---- Pinned ----
    for f in "$PIN_DIR"/*; do
        [ -f "$f" ] || continue
        hash=$(basename "$f")
        preview=$(file_info "$f")
        [ -z "$preview" ] && preview="(empty)"
        row "📌 $preview" "$(pin_icon "$f")" "pin:$hash"
    done

    # ---- History ----
    # cliphist list already flags images as "[[ binary data ... png WxH ]]",
    # so only those rows need decoding (for the thumbnail); text rows skip the
    # decode entirely.  Decoded thumbnails are cached by entry id so repeated
    # opens do not re-decode the whole history.
    while IFS=$'\t' read -r id content; do
        [ -n "$id" ] || continue
        preview=${content//$'\n'/ }
        preview=${preview//$'\t'/ }
        preview=${preview:0:80}
        preview=${preview//[[:cntrl:]]/}
        icon="accessories-text-editor"
        case "$content" in
            *'[[ binary data'*)
                thumb="$THUMB_DIR/$id.bin"
                if [ ! -s "$thumb" ]; then
                    printf '%s' "$id" | cliphist decode > "$thumb" 2>/dev/null || rm -f "$thumb"
                fi
                if [ -s "$thumb" ]; then
                    dims=$(magick identify -format '%wx%h' "$thumb" 2>/dev/null || true)
                    [ -n "$dims" ] && preview="Image $dims" || preview="Image"
                    icon="$thumb"
                fi
                ;;
        esac
        row "$preview" "$icon" "hist:$id"
    done < <(cliphist list)

    [ -s "$display" ]
}

# pick <prompt>: print the key of the selected row, or fail if cancelled.
pick() {
    local prompt="$1" idx
    idx=$(fuzzel --dmenu --index --config "$FUZZEL" -p "$prompt" < "$display" 2>/dev/null) || return 1
    [ -n "$idx" ] || return 1
    sed -n "$((idx + 1))p" "$map"
}

case "${1:-clip}" in
    clip)
        build_list || { notify-send -t 1500 cliphist "clipboard is empty"; exit 0; }
        key=$(pick "Clipboard") || exit 0
        [ -n "$key" ] || exit 0
        copy_key "$key"
        ;;
    manage)
        build_list manage || { notify-send -t 1500 cliphist "clipboard is empty"; exit 0; }
        key=$(pick "Manage") || exit 0
        [ -n "$key" ] || exit 0
        case "$key" in
            action:clear)
                cliphist wipe
                notify-send -t 1500 cliphist "history cleared"
                exit 0
                ;;
        esac
        if [[ "$key" == pin:* ]]; then
            action=$(printf 'Copy\nUnpin\nDelete' | fuzzel --dmenu --index --config "$FUZZEL" -p "pin>" 2>/dev/null) || exit 0
        else
            action=$(printf 'Copy\nPin\nDelete' | fuzzel --dmenu --index --config "$FUZZEL" -p "history>" 2>/dev/null) || exit 0
        fi
        case "$action" in
            0) copy_key "$key" ;;
            1)
                if [[ "$key" == pin:* ]]; then
                    rm -f "$PIN_DIR/${key#pin:}" && notify-send -t 1000 cliphist "unpinned"
                else
                    pin_entry "${key#hist:}" "$tmpdir/pin.bin" && notify-send -t 1000 cliphist "pinned"
                fi
                ;;
            2)
                if [[ "$key" == pin:* ]]; then
                    rm -f "$PIN_DIR/${key#pin:}" && notify-send -t 1000 cliphist "pinned deleted"
                else
                    cliphist delete "${key#hist:}" && notify-send -t 1000 cliphist "deleted"
                fi
                ;;
        esac
        ;;
    pass)
        if ! command -v pass &>/dev/null; then
            notify-send -u critical "pass" "not installed — run: pacman -S pass"
            exit 1
        fi
        entries=$(find "${PASSWORD_STORE_DIR:-$HOME/.password-store}" -name '*.gpg' -printf '%P\n' 2>/dev/null | sed 's/\.gpg$//' | sort)
        if [ -z "$entries" ]; then
            notify-send -u critical "pass" "password store empty — run: pass init <gpg-id>"
            exit 0
        fi
        choice=$(printf '%s\n' "$entries" | fuzzel --dmenu --config "$FUZZEL" -p "pass>" 2>/dev/null)
        [ -n "$choice" ] && pass -c "$choice" 2>/dev/null && notify-send -t 1000 "pass" "copied $choice"
        ;;
esac
exit 0
