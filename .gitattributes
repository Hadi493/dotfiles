# Binary / generated assets: keep out of text diffs, use LFS if enabled
*.ttc filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.png -text diff=exif
*.jpg -text diff=exif
*.mp3 -text
*.ogg -text
*.wav -text
st/st-alpha-0.8.5.diff -text
include/nob.h linguist-generated=true -diff
.config/helix/runtime linguist-generated=true -diff
